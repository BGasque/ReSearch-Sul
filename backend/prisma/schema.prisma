generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Listas de opções fixas ----------

// Tipo de conta: define o que cada pessoa pode fazer no site
enum TipoConta {
  PESSOA // estudante ou pesquisador
  INSTITUICAO // instituição que cadastra eventos e publicações
  ADMIN // administrador, que aprova os conteúdos
}

enum TipoConteudo {
  EVENTO
  PUBLICACAO
}

// Como o evento acontece (RF03 e RF04)
enum Modalidade {
  PRESENCIAL
  ONLINE
  HIBRIDO
}

// Forma de acesso (RF03): evento gratuito ou pago; publicação de acesso aberto ou pago
enum FormaAcesso {
  GRATUITO
  PAGO
}

// Tipo de publicação (RF05 e RF14)
enum TipoPublicacao {
  REVISTA
  EDICAO
  CHAMADA
  ARTIGO
  ANAIS
  LIVRO
  OUTRA
}

// Estados da Região Sul
enum Estado {
  PR
  SC
  RS
}

// Só os conteúdos APROVADO aparecem para o público
enum Situacao {
  PENDENTE // esperando o administrador avaliar
  APROVADO
  RECUSADO
  ARQUIVADO // retirado do site (pela instituição ou pelo administrador)
  CORRECAO // o administrador pediu uma correção; a instituição edita e envia de novo
  OCULTO // escondido pelo administrador (não aparece para ninguém de fora)
}

// O que o administrador decidiu sobre um conteúdo (RF16: registro da decisão)
enum AcaoModeracao {
  APROVOU
  RECUSOU
  PEDIU_CORRECAO
  EDITOU
  OCULTOU
  ARQUIVOU
}

// ---------- Tabelas ----------

// 1. Usuários: pessoas, instituições e administradores
model Usuario {
  id       Int       @id @default(autoincrement())
  nome     String
  email    String    @unique
  senha    String // guardada criptografada
  tipo     TipoConta @default(PESSOA)
  lattes   String? // link público do Currículo Lattes (opcional)
  lattesId String? // número de 16 dígitos do currículo

  // Dados importados do XML do Lattes (nome, áreas, artigos, trabalhos em eventos)
  lattesDados       Json?
  lattesImportadoEm DateTime?
  termosAceitosEm   DateTime? // quando aceitou os Termos de uso e a Política de privacidade (prova do consentimento, LGPD art. 8º)
  // Recuperação de senha ("Esqueci a senha"): guardamos só o resumo (hash) do código, nunca o código
  resetSenhaHash    String?
  resetSenhaExpira  DateTime?
  // Controle do administrador (CU15)
  bloqueado         Boolean   @default(false) // conta bloqueada não consegue entrar
  verificado        Boolean   @default(false) // instituição conferida pelo administrador (só então pode cadastrar conteúdos)
  criadoEm          DateTime  @default(now())

  conteudos        Conteudo[] // conteúdos cadastrados (se for instituição)
  interesses       Interesse[]
  estadosInteresse InteresseEstado[]
  tiposInteresse   InteresseTipo[]
  tagsInteresse    InteresseTag[]
  favoritos        Favorito[]
  decisoes         Decisao[] // decisões de moderação que este administrador tomou
}

// 2. Áreas do conhecimento (ex.: Computação, Saúde)
model Area {
  id   Int    @id @default(autoincrement())
  nome String @unique

  conteudos  ConteudoArea[]
  interesses Interesse[]
}

// 3. Conteúdos: eventos e publicações
model Conteudo {
  id            Int          @id @default(autoincrement())
  tipo          TipoConteudo
  titulo        String
  descricao     String       @db.Text
  estado        Estado
  local         String? // cidade ou "Online" (eventos)
  autoria       String? // autores ou revista (publicações)
  dataInicio    DateTime? // início do evento
  dataFim       DateTime? // fim do evento
  prazo         DateTime? // prazo de inscrição ou de envio de artigos
  linkOficial   String       @db.VarChar(500)
  acesso        FormaAcesso? // gratuito ou pago (opcional, os dois tipos)

  // Só de eventos
  modalidade  Modalidade? // presencial, online ou híbrido
  publicoAlvo String? // ex.: "Estudantes do ensino médio e graduação"

  // Só de publicações
  tipoPublicacao TipoPublicacao? // revista, edição, chamada, artigo...
  ano            Int? // ano da publicação ou da edição
  doi            String? // identificador DOI (ex.: 10.1590/abc123)
  issn           String? // identificador ISSN da revista (ex.: 1234-5678)

  situacao      Situacao     @default(PENDENTE)
  instituicaoId Int
  publicadoEm   DateTime? // quando foi aprovado pela primeira vez (só assim um arquivado vira histórico público)
  motivoRecusa  String?      @db.Text // explicação do administrador quando recusa
  moderadoEm    DateTime? // última vez que o administrador aprovou ou recusou
  criadoEm      DateTime     @default(now())
  atualizadoEm  DateTime     @updatedAt

  instituicao Usuario        @relation(fields: [instituicaoId], references: [id])
  areas       ConteudoArea[]
  tags        ConteudoTag[]
  favoritos   Favorito[]
  decisoes    Decisao[]

  @@index([instituicaoId])
}

// Histórico da moderação: cada decisão do administrador sobre um conteúdo
model Decisao {
  id         Int           @id @default(autoincrement())
  conteudoId Int
  adminId    Int? // quem decidiu (fica vazio se a conta do admin for apagada)
  adminNome  String // nome do admin no momento da decisão (para o registro não se perder)
  acao       AcaoModeracao
  motivo     String?       @db.Text
  criadoEm   DateTime      @default(now())

  conteudo Conteudo @relation(fields: [conteudoId], references: [id], onDelete: Cascade)
  admin    Usuario? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([conteudoId])
  @@index([adminId])
}

// 4. Áreas de cada conteúdo (N para N: um conteúdo pode ter várias áreas)
model ConteudoArea {
  conteudoId Int
  areaId     Int

  conteudo Conteudo @relation(fields: [conteudoId], references: [id], onDelete: Cascade)
  area     Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([conteudoId, areaId])
  @@index([areaId])
}

// 5. Interesses: quais áreas cada usuário escolheu seguir
model Interesse {
  usuarioId Int
  areaId    Int

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  area    Area    @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([usuarioId, areaId])
  @@index([areaId])
}

// 6. Estados de interesse: de quais estados o usuário quer ver conteúdos
model InteresseEstado {
  usuarioId Int
  estado    Estado

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, estado])
}

// 6b. Tipos de interesse: se o usuário quer receber recomendações de eventos, de publicações ou dos dois
// (nenhum marcado = os dois)
model InteresseTipo {
  usuarioId Int
  tipo      TipoConteudo

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, tipo])
}

// 7. Tags: assuntos mais específicos (ex.: Extensão, Robótica, Feira de ciências), organizados em grupos
model Tag {
  id    Int     @id @default(autoincrement())
  nome  String  @unique
  grupo String // ex.: "Eixo", "Nível de ensino", "Formato", "Tema"
  ativa Boolean @default(true) // tag desativada some das escolhas, mas não apaga os vínculos

  conteudos  ConteudoTag[]
  interesses InteresseTag[]
}

// 8. Tags de cada conteúdo (N para N)
model ConteudoTag {
  conteudoId Int
  tagId      Int

  conteudo Conteudo @relation(fields: [conteudoId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conteudoId, tagId])
  @@index([tagId])
}

// 9. Tags preferidas de cada usuário (N para N), usadas nas recomendações
model InteresseTag {
  usuarioId Int
  tagId     Int

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([usuarioId, tagId])
  @@index([tagId])
}

// 10. Favoritos: eventos e publicações que cada usuário salvou com a estrelinha (N para N)
model Favorito {
  usuarioId  Int
  conteudoId Int
  criadoEm   DateTime @default(now())

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  conteudo Conteudo @relation(fields: [conteudoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, conteudoId])
  @@index([conteudoId])
}
