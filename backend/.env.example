# Copie este arquivo para ".env" e preencha com os seus dados.
# O ".env" de verdade NUNCA vai para o GitHub.

# Endereço do banco MySQL
# No computador (XAMPP): mysql://root@localhost:3306/researchsul
# Na nuvem (Aiven):      mysql://USUARIO:SENHA@ENDERECO:PORTA/defaultdb
DATABASE_URL="mysql://root@localhost:3306/researchsul"

# Liga a conexão segura (SSL). Use "true" no Aiven; deixe "false" no XAMPP.
DATABASE_SSL=false

# Chave secreta usada para assinar o login (JWT).
# Gere uma bem comprida e aleatória. Exemplo de comando para gerar:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
MY_SECRET_KEY=troque-por-uma-chave-secreta-comprida

# Endereço do site (front-end) que pode acessar a API. No computador, deixe vazio.
# Na nuvem, por exemplo: https://research-sul.vercel.app
FRONTEND_URL=

# Contas de teste criadas pelo "npm run seed"
SEED_ADMIN_EMAIL=admin@researchsul.test
SEED_ADMIN_SENHA=troque-esta-senha
SEED_INSTITUICAO_EMAIL=instituicao@researchsul.test
SEED_INSTITUICAO_SENHA=troque-esta-senha
